NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only; required for verified payment writes and webhook processing.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
# Required in production; use http://localhost:3000 for local development.
APP_BASE_URL=http://localhost:3000

# Razorpay Test Mode is the default. Use only Test Mode keys until live
# processing has been explicitly approved and verified.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_SERVER_ONLY_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SERVER_ONLY_RAZORPAY_WEBHOOK_SECRET

# Optional receipt branding. These do not configure tax calculation or GST.
BILLING_BUSINESS_NAME=
BILLING_BUSINESS_ADDRESS=
BILLING_SUPPORT_EMAIL=

# Server-only Gemini API key. Never prefix this value with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
